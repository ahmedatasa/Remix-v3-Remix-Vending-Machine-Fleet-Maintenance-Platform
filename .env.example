# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://vending_admin:vending_secure_password_2026@localhost:5432/vending_fleet_db"
POSTGRES_USER="vending_admin"
POSTGRES_PASSWORD="vending_secure_password_2026"
POSTGRES_DB="vending_fleet_db"
POSTGRES_PORT=5432
POSTGRES_HOST="localhost"

# WHATSAPP INTEGRATION CONFIGURATION (WhatsApp Business Cloud API)
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="vending_ksu_whatsapp_verify_token_2026"
WHATSAPP_DISPATCH_PHONE="+966500000000"

# ==============================================================================
# PHASE 5 — CLOUD & PRODUCTION CONFIGURATION
# ==============================================================================

# Container ingress port (Cloud Run sets this automatically)
PORT=3001
CLOUD_PORT=3001
NODE_ENV="development"

# Managed PostgreSQL Database URL (Cloud SQL / Supabase)
CLOUD_DATABASE_URL="postgresql://cloud_user:cloud_secret_password@db.example.com:5432/ksu_vending_cloud"
DATABASE_URL="postgresql://cloud_user:cloud_secret_password@db.example.com:5432/ksu_vending_cloud"

# Object Storage Provider: 'r2' | 's3' | 'supabase' | 'local'
CLOUD_STORAGE_PROVIDER="local"
CLOUD_STORAGE_BUCKET="ksu-vending-evidence"
CLOUD_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUD_STORAGE_REGION="auto"
CLOUD_STORAGE_ACCESS_KEY=""
CLOUD_STORAGE_SECRET_KEY=""
MAX_EVIDENCE_FILE_SIZE_BYTES=10485760

# Cloud Authentication & Security
CLOUD_SESSION_SECRET="ksu_vending_cloud_session_secret_2026_super_secure"
SYNC_CLIENT_ID="ksu-desktop-sync-client-2026"
SYNC_CLIENT_SECRET="sec_ksu_vending_sync_2026_d92f8a1c"

# Cloud Base URLs & CORS Allowed Origins
CLOUD_API_URL="http://127.0.0.1:3001"
PUBLIC_QR_BASE_URL="https://vending.ksu.edu.sa"
PUBLIC_WEB_ORIGIN="https://vending.ksu.edu.sa"
TECHNICIAN_WEB_ORIGIN="https://tech.vending.ksu.edu.sa"
ADMIN_ORIGIN="https://admin.vending.ksu.edu.sa"

# Desktop & Geofencing Parameters
LOCAL_SERVER_URL="http://localhost:3000"
TECHNICIAN_CHECKIN_RADIUS_METERS=100
TECHNICIAN_MAX_GPS_ACCURACY_METERS=100
SYNC_INTERVAL=60

